# OpenAI
OPENAI_API_KEY=

# Google Gemini through the OpenAI-compatible endpoint
GEMINI_API_KEY=

# Alibaba Cloud Model Studio / DashScope (Qwen)
DASHSCOPE_API_KEY=

# Hugging Face Inference Endpoints
HF_ENDPOINT_API_KEY=
HF_INTERNVL35_8B_BASE_URL=
HF_INTERNVL35_38B_BASE_URL=

# InternVL uses the released local images by default. Set this to "remote"
# only after uploading the released images to a repository you control.
INTERNVL_IMAGE_SOURCE=local

# Required only when INTERNVL_IMAGE_SOURCE=remote. No author-owned image
# repository is configured or used by this release.
HF_IMAGE_REPO_ID=
HF_IMAGE_REVISION=main
HF_LOCAL_IMAGE_ROOT=images
HF_IMAGE_ROOT=images
