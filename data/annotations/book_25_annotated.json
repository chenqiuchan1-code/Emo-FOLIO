    {
      "page": 12,
      "text": "萨米吓坏了，他尖叫着跑开了。",
      "image": "12.png",
      "labels": {
        "primary_emotion": "恐惧",
        "secondary_emotions": [
          "平静"
        ],
        "prev_trend_marks": [
