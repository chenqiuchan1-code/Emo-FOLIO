  "pages": [
    {
      "page": 1,
      "text": "窗外有一棵大树，树上住着布谷鸟，小米天天看它。",
      "image": "1.png",
      "labels": {
        "primary_emotion": "快乐",
        "secondary_emotions": [
          "平静",
          "好奇"
        ],
        "prev_trend_marks": [],
        "intent_tag": "逗趣"
      }
    },
    {
      "page": 2,
      "text": "早上，小米丢面包。布谷鸟唱：布谷，布谷。",
      "image": "2.png",
      "labels": {
        "primary_emotion": "快乐",
        "secondary_emotions": [],
        "prev_trend_marks": [
          "快乐+"
        ],
        "intent_tag": "逗趣"
      }
    },
    {
      "page": 3,
      "text": "今天早上，好安静。小米推开窗，发现布谷鸟躺在地上。",
      "image": "3.png",
      "labels": {
        "primary_emotion": "惊讶",
        "secondary_emotions": [
          "悲伤",
          "好奇"
        ],
        "prev_trend_marks": [],
        "intent_tag": "制造紧张"
      }
    },
    {
      "page": 4,
      "text": "小米跑到树下：“布谷鸟，起床啦！”布谷鸟不动。",
      "image": "4.png",
      "labels": {
        "primary_emotion": "惊讶",
        "secondary_emotions": [
          "恐惧",
          "好奇"
        ],
        "prev_trend_marks": [
