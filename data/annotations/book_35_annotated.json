          "愤怒"
        ],
        "prev_trend_marks": [
          "悲伤+",
          "愤怒-"
        ],
        "intent_tag": "信息传递"
      }
    },
    {
      "page": 4,
      "text": "“你会交到新朋友的。”妈妈说。“才不会！”西蒙赌气说，“这里才不是我的家，不是！”",
      "image": "4.png",
      "labels": {
        "primary_emotion": "愤怒",
        "secondary_emotions": [
          "悲伤"
        ],
        "prev_trend_marks": [
